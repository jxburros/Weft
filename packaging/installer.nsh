; Weft assisted-installer customizations, included by electron-builder's NSIS template.
; Bitmaps in this folder are generated by scripts/generate-installer-art.js.
; Policy: per-user install by default; upgrades and uninstalls keep workspace data
; unless the person explicitly opts in on the uninstall data page.

!ifndef BUILD_UNINSTALLER
  !define MUI_FINISHPAGE_TITLE "Weft is ready"
  !define MUI_FINISHPAGE_TEXT "Weft has been installed on this computer.$\r$\n$\r$\nYour workspaces stay local. Weft does not check for updates unless you turn on automatic checks or choose Check now in Settings > Updates."
!else
  !define MUI_UNFINISHPAGE_NOAUTOCLOSE
!endif

!macro customWelcomePage
  !define MUI_WELCOMEPAGE_TITLE "Welcome to Weft"
  !define MUI_WELCOMEPAGE_TEXT "Weft is a local workspace browser for working on projects with agents, with you in control.$\r$\n$\r$\nIt installs for your Windows account by default and does not need administrator rights or an online account. Existing workspaces are kept when you upgrade.$\r$\n$\r$\nChoose Next to continue."
  !insertmacro skipPageIfUpdated
  !insertmacro MUI_PAGE_WELCOME
!macroend

!macro customUnWelcomePage
  !define MUI_WELCOMEPAGE_TITLE "Uninstall Weft"
  !define MUI_WELCOMEPAGE_TEXT "This removes the Weft application from this computer.$\r$\n$\r$\nYour workspaces, captures and settings are kept unless you choose to remove them on the next page."
  !insertmacro MUI_UNPAGE_WELCOME
  UninstPage custom un.weftDataPageCreate un.weftDataPageLeave

  Var /GLOBAL weftRemoveData
  Var /GLOBAL weftRemoveDataBox

  Function un.weftDataPageCreate
    StrCpy $weftRemoveData "0"
    ${if} ${isUpdated}
      Abort
    ${endif}
    !insertmacro MUI_HEADER_TEXT "Your Weft data" "Choose whether to keep your workspaces."
    nsDialogs::Create 1018
    Pop $0
    StrCmp $0 "error" 0 +2
      Abort
    ${NSD_CreateLabel} 0 0 100% 56u "Weft keeps workspaces, captures, model connections, agent connections and browser sessions for this Windows account in $APPDATA\weft. They are kept after uninstalling, so reinstalling Weft picks up where you left off."
    Pop $0
    ${NSD_CreateCheckbox} 0 64u 100% 24u "Also permanently delete my Weft workspaces and settings (cannot be undone)"
    Pop $weftRemoveDataBox
    ${NSD_SetState} $weftRemoveDataBox ${BST_UNCHECKED}
    nsDialogs::Show
  FunctionEnd

  Function un.weftDataPageLeave
    ${NSD_GetState} $weftRemoveDataBox $0
    StrCmp $0 ${BST_CHECKED} 0 weftKeepData
    MessageBox MB_YESNO|MB_ICONEXCLAMATION|MB_DEFBUTTON2 "Permanently delete all Weft workspaces, captures and settings for this Windows account?" IDYES weftDeleteConfirmed
    ${NSD_SetState} $weftRemoveDataBox ${BST_UNCHECKED}
    Abort
    weftDeleteConfirmed:
    StrCpy $weftRemoveData "1"
    weftKeepData:
  FunctionEnd
!macroend

!macro customUnInstall
  ; Upgrades run the old uninstaller silently with --updated: never touch user data then.
  ${ifNot} ${isUpdated}
    ${if} $installMode == "all"
      SetShellVarContext current
    ${endif}
    ; The verified update cache is disposable; workspace data is removed only on explicit request.
    RMDir /r "$APPDATA\weft\updates"
    ${if} $weftRemoveData == "1"
      RMDir /r "$APPDATA\weft"
    ${endif}
    ${if} $installMode == "all"
      SetShellVarContext all
    ${endif}
  ${endif}
!macroend
