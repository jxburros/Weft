{
  "name": "weft",
  "version": "1.4.0",
  "description": "An agent-human handshake browser",
  "type": "module",
  "main": "src/main.js",
  "bin": {
    "weft": "bin/weft.js"
  },
  "scripts": {
    "start": "electron .",
    "cli": "node bin/weft.js",
    "mcp": "node bin/weft.js mcp",
    "test": "node --test \"test/**/*.test.js\"",
    "check": "node scripts/check.mjs",
    "lint": "eslint .",
    "test:unit": "node scripts/test-unit.mjs",
    "test:docs": "node --test test/docs.test.js",
    "test:perf": "node --test perf/budgets.js",
    "perf:responsiveness": "node perf/responsiveness.js",
    "evals": "node evals/run.js",
    "dist": "electron-builder --config electron-builder.config.cjs --publish never",
    "dist:dir": "electron-builder --config electron-builder.config.cjs --dir --publish never",
    "release:check": "node scripts/release/metadata.js",
    "installer:art": "node scripts/generate-installer-art.js",
    "logo:validate": "electron scripts/validate-logo.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jxburros/Weft"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "axe-core": "4.13.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "eslint": "10.13.0"
  }
}
